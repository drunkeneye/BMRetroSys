#
# Makefile for an Apple II kernel using BMX
#
# The KEGS core (vendored GSplus subset under third_party/apple2, plus the
# BMX glue under src/apple2) is compiled directly by the main Makefile
# (BMC64_OBJS + pattern rules), so there are no prebuilt VICE-style
# libraries to link. This file only selects the machine class and lets the
# main Makefile do the rest.
#

MACHINE_CLASS = RASPI_APPLE2

# Run the Apple II frame loop on core 1 like the other machines.
BMX_EMU_MULTICORE ?= 1

VICELIBS :=

include Makefile
