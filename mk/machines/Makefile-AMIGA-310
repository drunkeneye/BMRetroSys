#
# Makefile for an AMIGA kernel using BMX
#
# The vAmiga core is vendored (third_party/vamiga/Core, see
# third_party/vamiga/README.BMX); BMX glue lives in src/amiga. This file
# only selects the machine class and lets the main Makefile do the rest.
#

MACHINE_CLASS = RASPI_AMIGA

# Run the Amiga frame loop on core 1 like the other machines.
BMX_EMU_MULTICORE ?= 1

VICELIBS :=

include Makefile
